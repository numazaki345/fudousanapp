<h2 class="title_page">お客様情報の編集</h2>

<div class="property_view_table mt-5">
  <%= form_with model: @condition do |f| %>
    <table class="property_view_table">
      <tbody>
        <tr>
          <th class="property_view_table-title" rowspan="7">
            <%= f.label '希望条件' %>
          </th>
          <th class="property_view_table-title">
            <%= f.label 'エリア' %>
          </th>
          <td class="property_view_table-body">
            <%= f.text_field :area, class: 'form-control', placeholder: '東京都渋谷区', type: 'text' %>
          </td>
        </tr>

        <tr>
          <th class="property_view_table-title">
            <%= f.label '賃料' %>
          </th>
          <td class="property_view_table-body width-380">
            <div class="selectunit m-lefl-30">
              <%= f.select :rent_low, [...省略...] %> 〜
              <%= f.select :rent_high, [...省略...] %>
            </div>
            <div class="selectunit-optio">
              <ul class="option-list">
                <% checked_rent_options = @condition.rent_option.delete('"[] ').split(',') %>
                <% %w(管理費・共益費込み 駐車場代込み 礼金なし 敷金・保証金なし 初期費用カード決済可 家賃カード決済可).each do |rent_option| %>
                  <li>
                    <%= f.check_box :rent_option, { multiple: true, checked: checked_rent_options.include?(rent_option) }, rent_option, nil %>
                    <%= rent_option %>
                  </li>
                <% end %>
              </ul>
            </div>
          </td>
        </tr>

        <tr>
          <th class="property_view_table-title">
            <%= f.label '駅徒歩' %>
          </th>
          <td class="property_view_table-body">
            <ul class="option-list">
              <% %w(1分以内 5分以内 7分以内 10分以内 15分以内 20分以内 指定なし).each do |time| %>
                <li>
                  <%= f.radio_button :minute, time %>
                  <%= f.label :minute, time %>
                </li>
              <% end %>
            </ul>
          </td>
        </tr>

        <tr>
          <th class="property_view_table-title">
            <%= f.label '間取りタイプ' %>
          </th>
          <td class="property_view_table-body">
            <ul class="option-list">
              <% checked_madoris = @condition.madori.delete('"[] ').split(',') %>
              <% %w(ワンルーム 1K 1DK 1LDK 2K 2DK 2LDK 3K 3DK 3LDK 4K 4DK 4LDK 5K以上).each do |madori| %>
                <li>
                  <%= f.check_box :madori, { multiple: true, checked: checked_madoris.include?(madori) }, madori, nil %>
                  <%= madori %>
                </li>
              <% end %>
            </ul>
          </td>
        </tr>

        <tr>
          <th class="property_view_table-title">
            <%= f.label '建物種別' %>
          </th>
          <td class="property_view_table-body">
            <ul class="option-list">
              <% checked_buildings = @condition.building.delete('"[] ').split(',') %>
              <% %w(マンション アパート 一戸建て・その他).each do |building| %>
                <li>
                  <%= f.check_box :building, { multiple: true, checked: checked_buildings.include?(building) }, building, nil %>
                  <%= building %>
                </li>
              <% end %>
            </ul>
          </td>
        </tr>

        <tr>
          <th class="property_view_table-title">
            <%= f.label '築後年数' %>
          </th>
          <td class="property_view_table-body">
            <ul class="option-list">
              <% %w(新築 1年以内 3年以内 5年以内 7年以内 10年以内 15年以内 20年以内 25年以内 30年以内 指定しない).each do |year| %>
                <li>
                  <%= f.radio_button :completion, year %>
                  <%= f.label :completion, year %>
                </li>
              <% end %>
            </ul>
          </td>
        </tr>

        <tr>
          <th class="property_view_table-title">
            <%= f.label 'その他条件' %>
          </th>
          <td class="property_view_table-body">
            <%= f.text_field :row, class: 'form-control', placeholder: 'エアコン付き、ペット可', type: 'text' %>
          </td>
        </tr>
      </tbody>
    </table>
    <%= f.submit '登録する', class: 'btn btn-primary btn-block col-sm-12' %>
  <% end %>
</div>
